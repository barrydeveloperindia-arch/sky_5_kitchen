rules_version = '2';
// Hotel Sky 5 inventory. Every device signs in anonymously. Entries can be created and soft-deleted
// (deleted: true) but never edited or hard-deleted, so the full history is always recoverable.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /inventory_transactions/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['code', 'type', 'qty', 'date', 'by', 'location'])
        && request.resource.data.type in ['IN', 'OUT', 'TRANSFER']
        && request.resource.data.location is string
        && (request.resource.data.type != 'TRANSFER' || (request.resource.data.toLocation is string && request.resource.data.toLocation != request.resource.data.location))
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.code is string && request.resource.data.code.matches('SKY-[A-Z]{2}-[0-9]{3}')
        && request.resource.data.by is string && request.resource.data.by.size() > 0;
      allow delete: if false;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        && request.resource.data.deleted == true;
    }

    match /inventory_settings/{doc} {
      allow read, write: if signedIn();
    }

    // Selfie proof for staff self check-in / check-out (/attendance). Create once, never changed or deleted.
    match /hotel_attendance_photos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['logId', 'kind', 'staffName', 'at', 'data'])
        && request.resource.data.kind in ['in', 'out']
        && request.resource.data.logId is string && request.resource.data.staffName is string
        && request.resource.data.data is string && request.resource.data.data.matches('data:image/jpeg;base64,.*')
        && request.resource.data.data.size() <= 150000;
      allow update, delete: if false;
    }

    // Staff photos for the Staff Directory / ID card (one per staff ID). Can be replaced (new photo), never deleted.
    match /hotel_staff_photos/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && id.matches('SKY5-[0-9]{3}')
        && request.resource.data.keys().hasOnly(['staffId', 'data', 'at'])
        && request.resource.data.staffId == id
        && request.resource.data.data is string && request.resource.data.data.matches('data:image/jpeg;base64,.*')
        && request.resource.data.data.size() <= 150000;
      allow delete: if false;
    }

    // Registered staff faces (128 numbers each) for the check-in face match; "reset" empties one so it can be registered again.
    match /hotel_staff_faces/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['staffName', 'staffId', 'descriptor', 'source', 'photoId', 'at', 'reset'])
        && request.resource.data.descriptor is list
        && ((request.resource.data.reset == false && request.resource.data.descriptor.size() == 128 && request.resource.data.source in ['staff-photo', 'first-check-in'])
            || (request.resource.data.reset == true && request.resource.data.descriptor.size() == 0 && request.resource.data.source == 'reset'));
      allow delete: if false;
    }

    // Staff PINs: only a hash of "staff ID + PIN"; no device may ever read it. A first PIN can be saved once;
    // a change must carry the hash of the old PIN. Never deleted.
    match /hotel_staff_pins/{id} {
      allow read, delete: if false;
      allow create: if signedIn() && id.matches('SKY5-[0-9]{3}')
        && request.resource.data.keys().hasOnly(['h', 'at'])
        && request.resource.data.h is string && request.resource.data.h.size() == 64;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['h', 'at', 'old'])
        && request.resource.data.h is string && request.resource.data.h.size() == 64
        && request.resource.data.old == resource.data.h;
    }
    // A PIN check: the write is allowed only when the hash matches the saved PIN (right PIN = success).
    match /hotel_pin_checks/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['staffId', 'h', 'at'])
        && request.resource.data.staffId is string
        && exists(/databases/$(database)/documents/hotel_staff_pins/$(request.resource.data.staffId))
        && request.resource.data.h == get(/databases/$(database)/documents/hotel_staff_pins/$(request.resource.data.staffId)).data.h;
    }

    // Money fields must be real, non-negative numbers when present
    function okMoney(d, k) { return !(k in d) || (d[k] is number && d[k] >= 0); }
    // Basic shape checks so a bad or garbled save can never corrupt a room bill or a settlement
    function validHotel(col, d) {
      return (col != 'hotel_rooms' || (
                d.status in ['Clean', 'Occupied', 'Dirty']
                && d.price is number && d.price >= 0
                && okMoney(d, 'foodBill')
                && (!('guest' in d) || d.guest == null || d.guest is map)))
        && (col != 'hotel_settlements' || (
                okMoney(d, 'total') && okMoney(d, 'collected') && okMoney(d, 'refund') && okMoney(d, 'advance')))
        && (col != 'hotel_orders' || (!('status' in d) || d.status is string))
        && (col != 'hotel_attendance' || (
                d.staffName is string && d.staffName.size() > 0
                && (!('hours' in d) || (d.hours is number && d.hours >= 0 && d.hours < 48))
                && (!('deleted' in d) || d.deleted is bool)
                && (!('inLoc' in d) || d.inLoc == null || d.inLoc is map)
                && (!('outLoc' in d) || d.outLoc == null || d.outLoc is map)));
    }

    // OPS Center + shop live data (rooms, orders, logs, attendance, settlements, staff, menu).
    // Anyone on the app can read and save; nothing can be hard-deleted.
    match /{col}/{id} {
      allow read: if signedIn() && col in [
        'hotel_rooms', 'hotel_orders', 'hotel_settlements', 'hotel_cleaning_logs', 'hotel_checkout_logs',
        'hotel_laundry_logs', 'hotel_attendance', 'hotel_state', 'hotel_meta'];
      allow create, update: if signedIn() && col in [
        'hotel_rooms', 'hotel_orders', 'hotel_settlements', 'hotel_cleaning_logs', 'hotel_checkout_logs',
        'hotel_laundry_logs', 'hotel_attendance', 'hotel_state', 'hotel_meta']
        && validHotel(col, request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
